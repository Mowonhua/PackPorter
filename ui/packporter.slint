/**
 * 文件职责：主窗口 UI：布局、控件树与交互接线。
 * 定义范围：组件结构、属性声明、控件事件与回调的绑定关系、计划明细行组件与设置页；
 *           交互的业务逻辑全部由 Rust 侧回调实现，UI 不承载迁移规则。
 * 交互约定：控件可用性由状态属性驱动（plan-ready / busy 等），无效操作被禁用而非报错；
 *           反馈走单行状态栏（status-text，逐次覆盖），不再保留追加式日志。
 */

import { Button, ComboBox, ListView, LineEdit, ProgressIndicator, Spinner, Switch } from "std-widgets.slint";

// 计划预览列表的单行数据，由 Rust 侧从迁移计划构建。
export struct PlanEntryView {
    /// 资产相对路径。
    path: string,
    /// 资产级别标签（L1-L4）。
    level-label: string,
    /// 动作统计标签（复制数/保留数/合并键数）。
    action-label: string,
    /// 条目内文件或键位数量（含单位，Rust 侧格式化）。
    item-count: string,
    /// 无动作条目（源目录缺失等）：整行淡化并排在列表末尾。
    dimmed: bool,
}

// 设置页规则编辑器单行数据：一条迁移路径及其启用状态。
export struct RuleRowView {
    /// 迁移相对路径（目录以 / 结尾）。
    path: string,
    /// 是否启用该规则。
    enabled: bool,
}

// 规则编辑桥：级别面板组件经此调用 Rust 侧增删改回调，避免逐实例转发。
// 级别以序号 1-4 表示 L1-L4；add/update 返回 false 表示校验失败（保持编辑态）。
export global RuleEditorApi {
    callback add(int, string) -> bool;
    callback update(int, int, string) -> bool;
    callback remove(int, int);
    callback set-enabled(int, int, bool);
}

// 计划明细行：固定高度，供 ListView 逐条渲染。
component PlanRow inherits Rectangle {
    in property <PlanEntryView> entry;
    height: 32px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text { text: entry.level-label; min-width: 110px; color: #9ca3af; vertical-alignment: center; }
        Text {
            text: entry.path;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            color: entry.dimmed ? #c4c8cf : #1f2937;
        }
        Text { text: entry.item-count; min-width: 70px; horizontal-alignment: right; color: entry.dimmed ? #c4c8cf : #374151; vertical-alignment: center; }
        Text { text: entry.action-label; min-width: 200px; color: entry.dimmed ? #c4c8cf : #374151; vertical-alignment: center; }
    }
}

// 卡片容器：白底圆角 + 可选标题，作为主页面各分区的统一外壳。
component Card inherits Rectangle {
    in property <string> title;
    border-radius: 8px;
    background: white;
    border-width: 1px;
    border-color: #e4e7ec;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        if root.title != "": Text {
            text: root.title;
            font-weight: 700;
            color: #374151;
        }
        @children
    }
}

// 齿轮图标按钮：无边框、无背景，悬停/按下仅加深图标颜色。
// 高度跟随容器（头部整行），图标在按钮内水平垂直居中。
component GearButton inherits Rectangle {
    callback clicked();
    in property <bool> enabled: true;
    width: 38px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.4;
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Path {
        width: 26px;
        height: 26px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z";
        fill: touch.pressed ? #1f2937 : touch.has-hover ? #374151 : #6b7280;
    }
    accessible-role: button;
    accessible-label: "设置";
    accessible-action-default => { root.clicked(); }
}

// 窗口控制按钮：无边框窗口的自绘最小化/最大化/还原/关闭（kind：0=最小化 1=最大化 2=还原 3=关闭）。
// 关闭（danger）悬停为红色底白图标，其余悬停为浅灰底；图标用几何图形绘制，不引入图标字体。
component WindowControlButton inherits Rectangle {
    in property <int> kind;
    in property <bool> danger: false;
    in property <string> label;
    callback clicked();
    width: 44px;
    // 背景色收敛为属性，还原图标的前方块借同色遮盖两框交叠线。
    property <color> bg: ta.has-hover ? (root.danger ? #dc2626 : #e5e7eb) : transparent;
    property <color> icon-color: ta.has-hover && root.danger ? white : #374151;
    background: bg;
    ta := TouchArea {
        mouse-cursor: default;
        clicked => { root.clicked(); }
    }
    // 最小化：一条横线。
    if root.kind == 0: Rectangle {
        width: 10px;
        height: 1px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: root.icon-color;
    }
    // 最大化：空心方框。
    if root.kind == 1: Rectangle {
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-width: 1px;
        border-color: root.icon-color;
        background: transparent;
    }
    // 还原：两叠方框。
    if root.kind == 2: Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        Rectangle {
            x: 3px;
            width: 6px;
            height: 6px;
            border-width: 1px;
            border-color: root.icon-color;
            background: root.bg;
        }
        Rectangle {
            y: 3px;
            width: 6px;
            height: 6px;
            border-width: 1px;
            border-color: root.icon-color;
            background: root.bg;
        }
    }
    // 关闭：乘号字形（系统默认字体自带，避免图标字体依赖）。
    if root.kind == 3: Text {
        width: 100%;
        height: 100%;
        text: "×";
        font-size: 16px;
        color: root.icon-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}

// 幽灵按钮：无边框小尺寸操作按钮，悬停显示浅色底；danger 悬停转红色（删除类）。
component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    in property <color> text-color: #4b5563;
    in property <length> font-size: 12px;
    callback clicked();
    height: 24px;
    border-radius: 5px;
    background: ta.has-hover ? (root.danger ? #fee2e2 : #eef1f5) : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            font-size: root.font-size;
            vertical-alignment: center;
            color: ta.has-hover ? (root.danger ? #b91c1c : #1f2937) : root.text-color;
        }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
}

// 主操作按钮：默认深色；accent 为 true 时蓝色高亮并呼吸闪烁提醒未保存改动。
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> accent: false;
    callback clicked();
    // 脉冲相位：Timer 周期翻转，驱动背景在两个蓝色间平滑往复。
    property <bool> pulse-phase: false;
    height: 30px;
    min-width: 68px;
    border-radius: 6px;
    background: !root.accent ? (ta.has-hover ? #1f2937 : #374151)
                             : (root.pulse-phase ? #1d4ed8 : #3b82f6);
    animate background { duration: 400ms; easing: ease-in-out; }
    Timer {
        interval: 450ms;
        running: root.accent;
        triggered => { root.pulse-phase = !root.pulse-phase; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: white;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
}

// 设置页的单行开关：开关 + 主标题；可带行尾"配置"入口。
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> has-config: false;
    callback configure();
    spacing: 10px;
    Switch {
        checked <=> root.checked;
    }
    Text {
        text: root.label;
        font-weight: 600;
        color: #1f2937;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    if root.has-config: GhostButton {
        text: "配置";
        clicked => { root.configure(); }
    }
}

// 规则编辑单行：启用开关 + 路径展示；编辑态切换为输入框 + 保存/取消。
component RuleEditorRow inherits Rectangle {
    in property <RuleRowView> entry;
    in property <int> index;
    in property <int> level;
    in-out property <int> edit-index: -1;
    in-out property <string> edit-text;
    height: 30px;
    border-radius: 4px;
    background: row-ta.has-hover ? #eef1f5 : transparent;
    row-ta := TouchArea { }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 2px;
        spacing: 4px;
        Switch {
            checked: root.entry.enabled;
            toggled => { RuleEditorApi.set-enabled(root.level, root.index, self.checked); }
        }
        if root.edit-index == root.index: LineEdit {
            text <=> root.edit-text;
            horizontal-stretch: 1;
            accepted => {
                if (RuleEditorApi.update(root.level, root.index, root.edit-text)) {
                    root.edit-index = -1;
                }
            }
        }
        if root.edit-index != root.index: Text {
            text: root.entry.path;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
            font-size: 12px;
            color: root.entry.enabled ? #1f2937 : #9ca3af;
        }
        if root.edit-index == root.index: GhostButton {
            text: "保存";
            text-color: #15803d;
            clicked => {
                if (RuleEditorApi.update(root.level, root.index, root.edit-text)) {
                    root.edit-index = -1;
                }
            }
        }
        if root.edit-index == root.index: GhostButton {
            text: "取消";
            clicked => { root.edit-index = -1; }
        }
        if root.edit-index != root.index: GhostButton {
            text: "编辑";
            clicked => {
                root.edit-text = root.entry.path;
                root.edit-index = root.index;
            }
        }
        if root.edit-index != root.index: GhostButton {
            text: "删除";
            danger: true;
            // 删除会使后续行号位移，先退出编辑态防止改错行。
            clicked => {
                root.edit-index = -1;
                RuleEditorApi.remove(root.level, root.index);
            }
        }
    }
}

// 单个级别的规则编辑面板：路径清单（可滚动）+ 添加行 + 书写提示。
// 供规则配置弹窗承载，高度由弹窗约束，路径多时清单区内部滚动。
component RuleEditorPanel inherits Rectangle {
    in property <int> level;
    in property <[RuleRowView]> rows;
    property <int> edit-index: -1;
    property <string> edit-text;
    property <string> new-path;
    background: #f8fafc;
    border-radius: 6px;
    border-width: 1px;
    border-color: #e5e7eb;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        if root.rows.length == 0: Text {
            text: "该级别暂无迁移路径，可在下方添加。";
            font-size: 12px;
            color: #9ca3af;
        }
        Flickable {
            vertical-stretch: 1;
            // Flickable 不给子元素排布语义，裸 for 会堆叠在原点；
            // 用 alignment: start 的布局承载行清单，行数少时也不会被拉伸摊满。
            VerticalLayout {
                alignment: start;
                for r[i] in root.rows: RuleEditorRow {
                    entry: r;
                    index: i;
                    level: root.level;
                    edit-index <=> root.edit-index;
                    edit-text <=> root.edit-text;
                }
            }
        }
        HorizontalLayout {
            spacing: 4px;
            LineEdit {
                text <=> root.new-path;
                placeholder-text: "输入 .minecraft/ 下的相对路径";
                horizontal-stretch: 1;
                accepted => {
                    if (RuleEditorApi.add(root.level, root.new-path)) {
                        root.new-path = "";
                    }
                }
            }
            GhostButton {
                text: "添加";
                text-color: #1d4ed8;
                clicked => {
                    if (RuleEditorApi.add(root.level, root.new-path)) {
                        root.new-path = "";
                    }
                }
            }
        }
    }
}

// 规则配置弹窗：模态遮罩 + 居中卡片，承载单个级别的路径编辑面板。
component RuleDialog inherits Rectangle {
    in property <string> title;
    in property <int> level;
    in property <[RuleRowView]> rows;
    callback close();
    width: 100%;
    height: 100%;
    // Slint 颜色字面量为 #RRGGBBAA：40% 黑色遮罩压暗背景。
    background: #00000066;
    // 点击遮罩关闭；卡片内的空白点击由卡片自持 TouchArea 吞掉，防止误关。
    TouchArea {
        clicked => { root.close(); }
    }
    Rectangle {
        width: min(640px, parent.width - 48px);
        height: min(520px, parent.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: white;
        border-radius: 10px;
        TouchArea { }
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    font-size: 15px;
                    font-weight: 700;
                    color: #1f2937;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                GhostButton {
                    text: "×";
                    font-size: 16px;
                    clicked => { root.close(); }
                }
            }
            RuleEditorPanel {
                level: root.level;
                rows: root.rows;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "完成";
                    primary: true;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

// 主窗口：单页主流程（选择实例 → 自动出计划 → 执行 → 结果）+ 设置页切换。
// 无边框窗口：系统标题栏/边框由自绘顶栏与 Rust 命中测试子类替代（拖动/缩放/双击最大化）。
export component PackPorterWindow inherits Window {
    title: "PackPorter";
    no-frame: true;
    preferred-width: 900px;
    preferred-height: 640px;
    min-width: 760px;
    min-height: 520px;
    background: #f3f4f6;

    // ==================== 属性声明 ====================

    // ---- 实例与计划（主流程） ----
    // 实例列表条目（目录名展示），由服务层扫描后填充。
    in-out property <[string]> instance-names: [];
    // 源实例在下拉框中的索引；-1 表示未选择。
    in-out property <int> source-index: -1;
    // 目标实例在下拉框中的索引；-1 表示未选择。
    in-out property <int> target-index: -1;
    // 计划摘要文案（源/目标、规则数与跳过项）。
    in-out property <string> plan-summary: "";
    // 计划预览明细行（每条资产规则一行）。
    in-out property <[PlanEntryView]> plan-entries: [];
    // 当前是否已有一份可用计划（驱动执行/备份按钮可用性）。
    in-out property <bool> plan-ready: false;
    // 占用警告是否可见（阻断迁移）。
    in-out property <bool> lock-warning-visible: false;
    // 是否已配置 versions 目录（未配置时禁用扫描，避免可点即报错）。
    in-out property <bool> has-versions-dir: false;

    // ---- 忙碌与进度 ----
    // 扫描/计划生成等后台计算进行中（按钮禁用 + 菊花提示）。
    in-out property <bool> busy: false;
    // 迁移事务执行中（显示进度卡片）。
    in-out property <bool> executing: false;
    // 进度百分比 0-100；-1 表示不确定态。
    in-out property <int> progress-percent: -1;
    // 进度区域当前动作描述。
    in-out property <string> progress-text: "";

    // ---- 单行状态栏（覆盖式反馈：操作结果、错误与提示都在这里，逐次覆盖） ----
    // 最新一条反馈文案。
    in-out property <string> status-text: "";
    // 状态种类："info" / "success" / "error"，决定文字颜色。
    in-out property <string> status-kind: "info";

    // ---- 设置页 ----
    in-out property <bool> settings-open: false;
    in-out property <string> settings-versions-dir: "";
    in-out property <bool> settings-auto-backup: true;
    in-out property <bool> settings-include-saves: true;
    in-out property <bool> settings-include-packs: true;
    in-out property <bool> settings-include-moddata: true;
    in-out property <bool> settings-include-options: true;
    // 规则配置弹窗（模态）：点击级别行的「配置」打开，展示该级别的路径编辑面板。
    in-out property <bool> rule-dialog-visible: false;
    in-out property <int> rule-dialog-level: 1;
    in-out property <string> rule-dialog-title: "";
    in-out property <[RuleRowView]> rule-dialog-rows: [];

    // ---- 未保存改动检测（打开设置页时由 Rust 侧写入已保存快照） ----
    in-out property <string> saved-versions-dir: "";
    in-out property <bool> saved-auto-backup: true;
    in-out property <bool> saved-include-saves: true;
    in-out property <bool> saved-include-packs: true;
    in-out property <bool> saved-include-moddata: true;
    in-out property <bool> saved-include-options: true;
    // 规则草稿是否与已保存配置不同（规则回调实时维护）。
    in-out property <bool> saved-rules-dirty: false;

    // 是否存在未保存的设置改动：驱动保存按钮高亮提醒。
    pure function settings-dirty() -> bool {
        return saved-versions-dir != settings-versions-dir
            || saved-auto-backup != settings-auto-backup
            || saved-include-saves != settings-include-saves
            || saved-include-packs != settings-include-packs
            || saved-include-moddata != settings-include-moddata
            || saved-include-options != settings-include-options
            || saved-rules-dirty;
    }

    // ---- 无边框窗口镶边（供 Rust 命中测试子类读取，逻辑像素） ----
    // 标题栏整条高度：条带内、控制区之前为可拖动区（齿轮片段除外）。
    out property <length> titlebar-height: 52px;
    // 窗口控制区（最小化/最大化/关闭）在窗口内的起点 x：该点起整条为客户区。
    out property <length> titlebar-controls-x: titlebar-controls.x;
    // 紧随标题的设置按钮的可点击区 [start, end)：命中测试在此放行、其余拖动。
    out property <length> titlebar-gear-start: titlebar-gear.x;
    out property <length> titlebar-gear-end: titlebar-gear.x + titlebar-gear.width;

    // 状态栏颜色：错误红、成功绿、普通灰。
    pure function status-color() -> color {
        return self.status-kind == "error" ? #b91c1c
            : self.status-kind == "success" ? #15803d
            : #6b7280;
    }

    // ==================== 回调声明 ====================

    // 请求扫描 versions/ 实例列表。
    callback scan-requested();
    // 请求（重新）生成迁移计划；源/目标变化时由 changed 回调自动触发。
    callback plan-requested();
    // 请求执行迁移（用户在预览页确认后）。
    callback execute-requested();
    // 请求打开备份目录。
    callback open-backup-folder();
    // 设置页：进入 / 取消 / 保存 / 浏览目录。
    callback open-settings();
    callback cancel-settings();
    callback save-settings();
    callback browse-versions-dir();
    // 打开指定级别（1-4）的迁移路径配置弹窗。
    callback open-rule-dialog(int);

    // 选择变化即自动生成计划；合法性（是否已扫描、索引是否有效、是否忙碌）由 Rust 侧守卫。
    changed source-index => { root.plan-requested(); }
    changed target-index => { root.plan-requested(); }

    // ==================== 顶栏 ====================

    VerticalLayout {
        // 顶栏（自绘标题栏）：标题 + 设置入口 + 窗口控制。
        // 条带内控制区之前的空白由 Rust 命中测试返回 HTCAPTION，提供拖动与双击最大化；
        // 设置按钮紧随标题，其区间经 titlebar-gear-start/end 放行点击。
        Rectangle {
            height: root.titlebar-height;
            background: white;
            HorizontalLayout {
                padding-left: 20px;
                spacing: 8px;
                // 布局默认 stretch 会把齿轮摊到行尾与窗口按钮重叠，需显式靠左排布。
                alignment: start;
                Text {
                    text: "PackPorter";
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                titlebar-gear := GearButton {
                    enabled: !root.busy;
                    // 开合开关：设置页已打开时再点即关闭（走取消路径，不落任何改动）。
                    clicked => {
                        if (root.settings-open) {
                            root.cancel-settings();
                        } else {
                            root.open-settings();
                        }
                    }
                }
            }
            titlebar-controls := Rectangle {
                x: parent.width - self.width;
                width: 132px;
                height: parent.height;
                HorizontalLayout {
                    WindowControlButton {
                        label: "最小化";
                        kind: 0;
                        clicked => { root.minimized = true; }
                    }
                    WindowControlButton {
                        label: root.maximized ? "还原" : "最大化";
                        kind: root.maximized ? 2 : 1;
                        clicked => { root.maximized = !root.maximized; }
                    }
                    WindowControlButton {
                        label: "关闭";
                        kind: 3;
                        danger: true;
                        clicked => { root.close(); }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: #e4e7ec; }

        // ==================== 页面容器（条件实例化：未显示的页面不参与布局） ====================
        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            // ==================== 主流程页 ====================
            if !root.settings-open: VerticalLayout {
                spacing: 10px;

                // 第一步：选择实例。
                Card {
                    title: "选择实例";
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "源实例"; vertical-alignment: center; color: #374151; }
                        ComboBox {
                            min-width: 200px;
                            // 模型由扫描回调填充；选中索引双向同步，保证 UI 选中与 Rust 状态一致。
                            model: root.instance-names;
                            current-index <=> root.source-index;
                            enabled: root.instance-names.length > 0 && !root.busy;
                        }
                        Text { text: "目标实例"; vertical-alignment: center; color: #374151; }
                        ComboBox {
                            min-width: 200px;
                            model: root.instance-names;
                            current-index <=> root.target-index;
                            enabled: root.instance-names.length > 0 && !root.busy;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Spinner {
                            visible: root.busy;
                            width: 24px;
                            height: 24px;
                            indeterminate: true;
                        }
                        Button {
                            text: root.instance-names.length > 0 ? "重新扫描" : "扫描实例";
                            enabled: root.has-versions-dir && !root.busy;
                            clicked => { root.scan-requested(); }
                        }
                    }
                    if root.lock-warning-visible: Text {
                        text: "检测到实例正被运行中的游戏进程占用，迁移已被阻断。请关闭对应游戏后重试。";
                        color: #b91c1c;
                        wrap: word-wrap;
                    }
                }

                // 第二步：计划预览（选满源与目标后自动生成，支持手动重新生成）。
                Card {
                    title: "迁移计划";
                    vertical-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.plan-summary;
                            color: #374151;
                            wrap: word-wrap;
                            visible: root.plan-ready;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "重新生成";
                            enabled: root.source-index > 0 && root.target-index > 0 && !root.busy && !root.executing;
                            clicked => { root.plan-requested(); }
                        }
                    }
                    if !root.plan-ready && !root.busy: Text {
                        text: "在上方选择源实例与目标实例，会自动生成迁移计划。";
                        color: #9ca3af;
                        vertical-alignment: center;
                    }
                    ListView {
                        vertical-stretch: 1;
                        visible: root.plan-ready;
                        for e in root.plan-entries: PlanRow {
                            entry: e;
                        }
                    }
                }

                // 执行进度卡片（仅执行期间出现）。
                if root.executing: Card {
                    HorizontalLayout {
                        spacing: 12px;
                        ProgressIndicator {
                            progress: root.progress-percent * 1.0 / 100.0;
                            indeterminate: root.progress-percent < 0;
                            min-width: 220px;
                        }
                        Text {
                            text: root.progress-percent >= 0 ? "\{root.progress-percent}%" : "";
                            min-width: 52px;
                            vertical-alignment: center;
                            color: #374151;
                        }
                    }
                    Text {
                        text: root.progress-text;
                        color: #6b7280;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }

                // 底部操作条。
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "开始迁移";
                        primary: true;
                        enabled: root.plan-ready && !root.busy && !root.executing;
                        clicked => { root.execute-requested(); }
                    }
                    Button {
                        text: "打开备份目录";
                        enabled: root.plan-ready && !root.busy && !root.executing;
                        clicked => { root.open-backup-folder(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ==================== 设置页 ====================
            if root.settings-open: VerticalLayout {
                spacing: 10px;

                Card {
                    title: "Minecraft 目录";
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.settings-versions-dir;
                            placeholder-text: "例如 D:\\Minecraft\\.minecraft\\versions";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "浏览…";
                            clicked => { root.browse-versions-dir(); }
                        }
                    }
                }

                Card {
                    title: "迁移内容";
                    VerticalLayout {
                        spacing: 12px;
                        SettingRow {
                            label: "迁移前自动备份";
                            checked <=> root.settings-auto-backup;
                        }
                        SettingRow {
                            label: "存档与个人资产（L1）";
                            checked <=> root.settings-include-saves;
                            has-config: true;
                            configure => { root.open-rule-dialog(1); }
                        }
                        SettingRow {
                            label: "资源包与光影包（L2）";
                            checked <=> root.settings-include-packs;
                            has-config: true;
                            configure => { root.open-rule-dialog(2); }
                        }
                        SettingRow {
                            label: "模组数据（L3）";
                            checked <=> root.settings-include-moddata;
                            has-config: true;
                            configure => { root.open-rule-dialog(3); }
                        }
                        SettingRow {
                            label: "客户端偏好（L4）";
                            checked <=> root.settings-include-options;
                            has-config: true;
                            configure => { root.open-rule-dialog(4); }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "取消";
                        clicked => { root.cancel-settings(); }
                    }
                    ActionButton {
                        text: "保存";
                        // 默认深色；有未保存改动时切换为醒目蓝色提醒保存。
                        accent: root.settings-dirty();
                        clicked => { root.save-settings(); }
                    }
                }
            }
        }

        // ==================== 常驻状态栏（覆盖式单行反馈，两个页面共享） ====================
        Rectangle { height: 1px; background: #e4e7ec; }
        Rectangle {
            height: 30px;
            background: white;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                Text {
                    text: root.status-text;
                    color: root.status-color();
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // ==================== 规则配置弹窗（模态，覆盖全窗口含标题栏） ====================
    if root.settings-open && root.rule-dialog-visible: RuleDialog {
        title: root.rule-dialog-title;
        level: root.rule-dialog-level;
        rows: root.rule-dialog-rows;
        close => { root.rule-dialog-visible = false; }
    }
}
